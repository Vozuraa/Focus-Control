<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Control" Width="1010" Height="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="IceBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFFFF" Offset="0"/>
      <GradientStop Color="#FFD5DBE3" Offset="0.34"/>
      <GradientStop Color="#FFF9FBFD" Offset="0.68"/>
      <GradientStop Color="#FFB9C3CE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RingBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFAEBBCB" Offset="0"/>
      <GradientStop Color="#FFF8F3FF" Offset="0.5"/>
      <GradientStop Color="#FFB5C1D0" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ClockDigit" TargetType="TextBlock">
      <Setter Property="Width" Value="52"/>
      <Setter Property="FontSize" Value="82"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource IceBrush}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="SecondsDigit" TargetType="TextBlock">
      <Setter Property="Width" Value="18"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#FFCFD7E0"/>
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#FFF1F4F7"/>
      <Setter Property="Background" Value="#FF262B32"/>
      <Setter Property="BorderBrush" Value="#32FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Face" CornerRadius="11" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#FF39414B"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="#62FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#FF505B69"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="NavButton" TargetType="{x:Type Button}">
      <Setter Property="Height" Value="47"/>
      <Setter Property="Margin" Value="12,3"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#FFC4CAD2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="NavFace" Background="{TemplateBinding Background}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavFace" Property="Background" Value="#1BFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FluidThumb" TargetType="{x:Type Thumb}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="Knob" Width="23" Height="23" CornerRadius="12"
                    Background="#FFF0EBF6" BorderBrush="#FFAD96C2" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/></Border.Effect>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FluidSlider" TargetType="{x:Type Slider}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Slider}">
            <Grid Height="32">
              <Border Height="5" CornerRadius="3" Background="#FF464B56"
                      VerticalAlignment="Center" Margin="10,0"/>
              <Track x:Name="PART_Track" Height="32" Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="5" Background="#FFA88ABF" CornerRadius="3"
                                VerticalAlignment="Center" Margin="10,0,0,0"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource FluidThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwitchRow" TargetType="{x:Type ToggleButton}">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="#FFE4E8ED"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Grid Background="Transparent">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <Border x:Name="SwitchTrack" Width="44" Height="24" CornerRadius="12"
                      Background="#FF373C44" BorderBrush="#3BFFFFFF" BorderThickness="1"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Margin="2"
                         HorizontalAlignment="Left" Fill="#FFF5F7FA">
                  <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="20" Duration="0:0:0.2"/>
                      <ColorAnimation Storyboard.TargetName="SwitchTrack"
                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                      To="#FF9B88B1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="0" Duration="0:0:0.2"/>
                      <ColorAnimation Storyboard.TargetName="SwitchTrack"
                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                      To="#FF373C44" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PositionCard" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FFDCE2E9"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="Card" Height="83" Background="#FF242930" BorderBrush="#3BFFFFFF"
                    BorderThickness="1" CornerRadius="13">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="76" Height="35" Margin="0,0,0,6">
                  <Border BorderBrush="#FF7F8995" BorderThickness="1" CornerRadius="5"/>
                  <Border x:Name="Marker" Width="22" Height="8" Margin="4" CornerRadius="4"
                          Background="#FFEDF3FA" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
                <ContentPresenter HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#FF39434E"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD6B7F3"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#FFE5EBF2"/>
              </Trigger>
              <Trigger Property="Tag" Value="TopRight">
                <Setter TargetName="Marker" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="Tag" Value="BottomLeft">
                <Setter TargetName="Marker" Property="VerticalAlignment" Value="Bottom"/>
              </Trigger>
              <Trigger Property="Tag" Value="BottomRight">
                <Setter TargetName="Marker" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Marker" Property="VerticalAlignment" Value="Bottom"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MetricCard" TargetType="{x:Type ToggleButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="MetricFace" CornerRadius="13" Height="83"
                    Background="#FF22272F" BorderBrush="#35FFFFFF" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" Margin="16,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="MetricFace" Property="Background" Value="#FF33333F"/>
                <Setter TargetName="MetricFace" Property="BorderBrush" Value="#FFBCA0D4"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MetricFace" Property="BorderBrush" Value="#FFE1D5EC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentCard" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="AccentFace" Height="65" CornerRadius="11"
                    Background="#FF252A32" BorderBrush="#35FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="AccentFace" Property="BorderBrush" Value="#FFE1D7EC"/>
                <Setter TargetName="AccentFace" Property="Background" Value="#FF343640"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="#FFF4F6F8"/>
      <Setter Property="Background" Value="#FF15191E"/>
      <Setter Property="BorderBrush" Value="#48FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border CornerRadius="9" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="AppSurface" Margin="10" CornerRadius="24" BorderThickness="1"
          BorderBrush="#4CFFFFFF" Background="#FF0D0F13" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="205"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarSurface" Grid.Column="0" Background="#FF15181D" CornerRadius="23,0,0,23"
              BorderBrush="#1BFFFFFF" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="92"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="24,24,0,0">
            <TextBlock Text="FOCUS" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource IceBrush}"/>
            <TextBlock Text="CONTROL" FontSize="10" FontWeight="Bold" Foreground="#FF8F99A5"
                       Margin="2,-3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="NAVIGATION" FontSize="9" FontWeight="Bold" Foreground="#FF77818D"
                       Margin="26,0,0,10"/>
            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"
                    AutomationProperties.Name="Vue d'ensemble">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="23" Height="23">
                  <Path Fill="#FFE7DBF2" Data="M 12,2 L 22,11 L 20.4,13 L 19,11.7 L 19,21 L 14,21 L 14,15 L 10,15 L 10,21 L 5,21 L 5,11.7 L 3.6,13 L 2,11 Z"/>
                </Viewbox>
                <TextBlock Text="Vue d'ensemble" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavCustomize" Style="{StaticResource NavButton}"
                    AutomationProperties.Name="Personnaliser">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="23" Height="23">
                  <Path Data="M 3,5 L 20,5 M 3,12 L 20,12 M 3,19 L 20,19"
                        Stroke="#FFE7DBF2" StrokeThickness="2.4" StrokeStartLineCap="Round"/>
                  <Ellipse Width="6" Height="6" Fill="#FF15181D" Stroke="#FFE7DBF2" StrokeThickness="2"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,0,0"/>
                  <Ellipse Width="6" Height="6" Fill="#FF15181D" Stroke="#FFE7DBF2" StrokeThickness="2"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,9,0,0"/>
                  <Ellipse Width="6" Height="6" Fill="#FF15181D" Stroke="#FFE7DBF2" StrokeThickness="2"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,16,0,0"/>
                </Grid>
                <TextBlock Text="Personnaliser" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}"
                    AutomationProperties.Name="Réglages">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="23" Height="23">
                  <Path Data="M 9,1.5 L 14,1.5 L 14.7,4 L 17,5 L 19.5,3.8 L 22,7.4 L 20,9.3 L 20,13.7 L 22,15.6 L 19.5,19.2 L 17,18 L 14.7,19 L 14,21.5 L 9,21.5 L 8.3,19 L 6,18 L 3.5,19.2 L 1,15.6 L 3,13.7 L 3,9.3 L 1,7.4 L 3.5,3.8 L 6,5 L 8.3,4 Z"
                        Stroke="#FFE7DBF2" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                  <Ellipse Width="6" Height="6" Stroke="#FFE7DBF2" StrokeThickness="2"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Réglages" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Canvas x:Name="NavIndicatorCanvas" Grid.Row="1" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="NavIndicator" Canvas.Left="13" Canvas.Top="47"
                    Width="3" Height="23" CornerRadius="2" Background="#FFD3A4FF"/>
          </Canvas>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="53"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="NavLicense" Grid.Row="0" Style="{StaticResource NavButton}"
                    AutomationProperties.Name="Licence" ToolTip="À propos et licence">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="©" Width="23" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFE7DBF2" TextAlignment="Center"/>
                <TextBlock Text="Licence" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="SidebarStatus" Grid.Row="1" Text="" FontSize="10"
                       Foreground="#FFD9E0E8" Margin="24,0,12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="DragHandle" Grid.Row="0" CornerRadius="0,23,0,0"
                Background="#FF111419" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
          <Grid Margin="25,0,17,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Focus Control" VerticalAlignment="Center" FontSize="12"
                       FontWeight="SemiBold" Foreground="#FFB7C0CB"/>
            <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource HeaderButton}"
                    ToolTip="Réduire" AutomationProperties.Name="Réduire">
              <Path Data="M 1,8 L 17,8" Stroke="#FFE6EBF1" StrokeThickness="1.7"
                    Width="18" Height="16" Stretch="Fill"/>
            </Button>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource HeaderButton}"
                    ToolTip="Fermer" AutomationProperties.Name="Fermer">
              <Path Data="M 2,2 L 16,16 M 16,2 L 2,16" Stroke="#FFE6EBF1"
                    StrokeThickness="1.7" Width="18" Height="18" Stretch="Fill"/>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="27,17,27,23">
          <Grid x:Name="DashboardPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="37"/>
              <RowDefinition Height="180"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="228"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock Text="VUE D'ENSEMBLE" FontSize="10" FontWeight="Bold"
                         Foreground="#FF9BA6B2" VerticalAlignment="Center"/>
              <Button x:Name="TimerOpenButton" Style="{StaticResource ActionButton}"
                      HorizontalAlignment="Right" Height="32" Padding="11,4" ToolTip="Afficher ou masquer le minuteur"
                      AutomationProperties.Name="Minuteur">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M 8,1 L 16,1 M 12,1 L 12,4 M 19,5 L 21,3 M 12,5 A 8,8 0 1 1 11.99,5 M 12,9 L 12,13 L 15,15"
                        Stroke="#FFE8D9F3" StrokeThickness="2" StrokeStartLineCap="Round"
                        Width="22" Height="22" Stretch="Fill"/>
                  <TextBlock Text="Minuteur" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <Border x:Name="ClockSurface" Grid.Row="1" CornerRadius="19" Background="#FF171B21"
                    BorderBrush="#32FFFFFF" BorderThickness="1">
              <Grid Margin="24,15">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="ClockLabel" Text="HEURE LOCALE" FontSize="10" FontWeight="Bold"
                             Foreground="#FFB49BCB" Margin="4,0,0,0"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="HourTens" Text="0" Style="{StaticResource ClockDigit}"/>
                    <TextBlock x:Name="HourOnes" Text="0" Style="{StaticResource ClockDigit}"/>
                    <TextBlock Text=":" Style="{StaticResource ClockDigit}" Width="25"/>
                    <TextBlock x:Name="MinuteTens" Text="0" Style="{StaticResource ClockDigit}"/>
                    <TextBlock x:Name="MinuteOnes" Text="0" Style="{StaticResource ClockDigit}"/>
                    <StackPanel x:Name="SecondsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="8,0,0,14" Visibility="Collapsed">
                      <TextBlock x:Name="SecondTens" Text="0" Style="{StaticResource SecondsDigit}"/>
                      <TextBlock x:Name="SecondOnes" Text="0" Style="{StaticResource SecondsDigit}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <UniformGrid x:Name="DashboardGaugePanel" Grid.Row="3" Columns="3"
                         Height="220" VerticalAlignment="Top">
              <Border x:Name="CpuCard" Margin="0,0,8,0" CornerRadius="18" Background="#FF181C22"
                      BorderBrush="#30FFFFFF" BorderThickness="1">
                <StackPanel Margin="17,13,17,10" VerticalAlignment="Center">
                  <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#FFD8E0E8"/>
                  <Grid Width="156" Height="156" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Ellipse Width="136" Height="136" Stroke="#29DDE7F2" StrokeThickness="8"/>
                    <Path x:Name="CpuArc" Stroke="{StaticResource RingBrush}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    </Path>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="CpuPercentText" Text="--" FontSize="31" FontWeight="SemiBold"
                                 Foreground="{StaticResource IceBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="UTILISATION" FontSize="8" FontWeight="Bold" Foreground="#FF86919E"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="CpuDetail" Text="Charge système" FontSize="10"
                             Foreground="#FF9EA8B4" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border x:Name="GpuCard" Margin="4,0" CornerRadius="18" Background="#FF181C22"
                      BorderBrush="#30FFFFFF" BorderThickness="1">
                <StackPanel Margin="17,13,17,10" VerticalAlignment="Center">
                  <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="#FFD8E0E8"/>
                  <Grid Width="156" Height="156" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Ellipse Width="136" Height="136" Stroke="#29DDE7F2" StrokeThickness="8"/>
                    <Path x:Name="GpuArc" Stroke="{StaticResource RingBrush}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    </Path>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="GpuPercentText" Text="--" FontSize="31" FontWeight="SemiBold"
                                 Foreground="{StaticResource IceBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="GpuTempInGauge" Text="-- °C" FontSize="10"
                                 Foreground="#FFAFBAC6" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="GpuDetail" Text="Lecture du capteur" FontSize="10"
                             Foreground="#FF9EA8B4" HorizontalAlignment="Center"
                             MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
              <Border x:Name="RamCard" Margin="8,0,0,0" CornerRadius="18" Background="#FF181C22"
                      BorderBrush="#30FFFFFF" BorderThickness="1">
                <StackPanel Margin="17,13,17,10" VerticalAlignment="Center">
                  <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="#FFD8E0E8"/>
                  <Grid Width="156" Height="156" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Ellipse Width="136" Height="136" Stroke="#29DDE7F2" StrokeThickness="8"/>
                    <Path x:Name="RamArc" Stroke="{StaticResource RingBrush}" StrokeThickness="8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    </Path>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="RamPercentText" Text="--" FontSize="31" FontWeight="SemiBold"
                                 Foreground="{StaticResource IceBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="UTILISATION" FontSize="8" FontWeight="Bold" Foreground="#FF86919E"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="RamDetail" Text="Mémoire physique" FontSize="10"
                             Foreground="#FF9EA8B4" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock x:Name="DashboardEmptyHint" Grid.Row="3" Text="Choisissez vos jauges dans Personnaliser."
                       Foreground="#FF9EA8B4" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <Border x:Name="TimerSurface" Grid.Row="4" Height="0" Opacity="0" Visibility="Collapsed"
                    CornerRadius="16" Background="#FF171B20"
                    BorderBrush="#2CFFFFFF" BorderThickness="1" Margin="0,5,0,0">
              <Grid Margin="16,0">
                <Grid x:Name="TimerSetupPanel" Visibility="Visible">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MINUTEUR" FontSize="10" FontWeight="Bold" Foreground="#FF9DA8B4"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="TimerMinutesBox" Style="{StaticResource DarkTextBox}"
                             Width="54" Text="25" TextAlignment="Center"/>
                    <TextBlock Text="min" FontSize="12" Foreground="#FFB8C2CC"
                               VerticalAlignment="Center" Margin="8,0,14,0"/>
                    <Button x:Name="TimerStartButton" Style="{StaticResource ActionButton}" Content="Démarrer"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="TimerActivePanel" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MINUTEUR" FontSize="10" FontWeight="Bold" Foreground="#FF9DA8B4"
                               VerticalAlignment="Center" Margin="0,0,17,0"/>
                    <TextBlock x:Name="TimerTimeText" Text="25:00" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource IceBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="TimerPauseButton" Style="{StaticResource ActionButton}" Content="Pause" Margin="0,0,7,0"/>
                    <Button x:Name="TimerStopButton" Style="{StaticResource ActionButton}" Content="Stop" Margin="0,0,7,0"/>
                    <Button x:Name="TimerRemoveButton" Style="{StaticResource ActionButton}" Content="Retirer"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="CustomizePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="98"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="PERSONNALISER" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2"/>
              <TextBlock x:Name="CustomizeSubtitle" Text="Composez votre assistant flottant" FontSize="18" FontWeight="SemiBold"
                         Foreground="#FFF2F5F8" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                <Button x:Name="CustomizeOverlayButton" Style="{StaticResource ActionButton}"
                        Content="Superposition" Padding="12,5" Margin="0,0,7,0"/>
                <Button x:Name="CustomizeDashboardButton" Style="{StaticResource ActionButton}"
                        Content="Vue d'ensemble" Padding="12,5"/>
              </StackPanel>
            </StackPanel>
            <Grid x:Name="OverlayCustomizePanel" Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="OverlayCustomizeSurface" Grid.Column="0" CornerRadius="18" Background="#FF171B20"
                      BorderBrush="#34FFFFFF" BorderThickness="1" Padding="17">
                <StackPanel>
                  <TextBlock Text="APERÇU EN DIRECT" FontSize="10" FontWeight="Bold"
                             Foreground="#FF9BA6B2" Margin="0,0,0,15"/>
                  <Grid HorizontalAlignment="Left" MinWidth="215">
                    <Border CornerRadius="17">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#FF26354A" Offset="0"/>
                          <GradientStop Color="#FF333047" Offset="0.55"/>
                          <GradientStop Color="#FF17212D" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border x:Name="PreviewSurface" CornerRadius="17" Background="#7512161C"
                            BorderBrush="#35FFFFFF" BorderThickness="1" Padding="16" MinWidth="215">
                      <StackPanel x:Name="PreviewWidgetHost"/>
                    </Border>
                  </Grid>
                  <TextBlock Text="La superposition suit cet ordre." FontSize="11"
                             Foreground="#FF8E99A5" Margin="1,17,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="26"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="28"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="AFFICHÉ DANS LA SUPERPOSITION" FontSize="10"
                           FontWeight="Bold" Foreground="#FFB8C3CE" VerticalAlignment="Top"/>
                <Border x:Name="ActiveDropZone" Grid.Row="1" AllowDrop="True"
                        CornerRadius="14" Background="#FF1D2229" BorderBrush="#45FFFFFF"
                        BorderThickness="1" Padding="7">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ActiveWidgetPanel"/>
                  </ScrollViewer>
                </Border>
                <TextBlock Grid.Row="2" Text="MASQUÉ" FontSize="10" FontWeight="Bold"
                           Foreground="#FF8F9BA7" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                <Border x:Name="InactiveDropZone" Grid.Row="3" AllowDrop="True"
                        CornerRadius="14" Background="#FF161A1F" BorderBrush="#30FFFFFF"
                        BorderThickness="1" Padding="7">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InactiveWidgetPanel"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
            <Grid x:Name="DashboardCustomizePanel" Grid.Row="1" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="DashboardCustomizeSurface" Grid.Column="0" CornerRadius="18" Background="#FF171B20"
                      BorderBrush="#34FFFFFF" BorderThickness="1" Padding="17">
                <StackPanel>
                  <TextBlock Text="APERÇU DE LA VUE D'ENSEMBLE" FontSize="10" FontWeight="Bold"
                             Foreground="#FF9BA6B2" Margin="0,0,0,16"/>
                  <Border CornerRadius="13" Background="#FF20252D" Padding="12" Margin="0,0,0,11">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="HEURE LOCALE" FontSize="9" Foreground="#FFB49BCB"/>
                      <TextBlock x:Name="PreviewClock" Text="12:42" FontSize="38" FontWeight="SemiBold"
                                 Foreground="{StaticResource IceBrush}"/>
                    </StackPanel>
                  </Border>
                  <UniformGrid Columns="3">
                    <Border x:Name="PreviewCpuCard" CornerRadius="10" Background="#FF252A33" Margin="0,0,4,0" Height="72">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="PreviewCpuRing" Width="23" Height="23" Stroke="#FFD8E2EE" StrokeThickness="4"/>
                        <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFE6EDF4" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border x:Name="PreviewGpuCard" CornerRadius="10" Background="#FF252A33" Margin="2,0" Height="72">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="PreviewGpuRing" Width="23" Height="23" Stroke="#FFD8E2EE" StrokeThickness="4"/>
                        <TextBlock Text="GPU" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFE6EDF4" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border x:Name="PreviewRamCard" CornerRadius="10" Background="#FF252A33" Margin="4,0,0,0" Height="72">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="PreviewRamRing" Width="23" Height="23" Stroke="#FFD8E2EE" StrokeThickness="4"/>
                        <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFE6EDF4" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <TextBlock Text="Cliquez sur les cartes pour composer votre page d'accueil."
                             FontSize="11" Foreground="#FF8E99A5" TextWrapping="Wrap" Margin="1,18,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2">
                <TextBlock Text="INDICATEURS VISIBLES" FontSize="10" FontWeight="Bold"
                           Foreground="#FFB8C3CE" Margin="0,0,0,13"/>
                <ToggleButton x:Name="DashboardCpuToggle" Style="{StaticResource MetricCard}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Stroke="#FFD7DCE7" StrokeThickness="5" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Foreground="#FFF2F5F8"/>
                      <TextBlock Text="Charge du processeur" FontSize="10" Foreground="#FF9CA8B4"/>
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="DashboardGpuToggle" Style="{StaticResource MetricCard}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Stroke="#FFD7DCE7" StrokeThickness="5" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" Foreground="#FFF2F5F8"/>
                      <TextBlock Text="Activité et température" FontSize="10" Foreground="#FF9CA8B4"/>
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="DashboardRamToggle" Style="{StaticResource MetricCard}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Stroke="#FFD7DCE7" StrokeThickness="5" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="RAM" FontSize="13" FontWeight="SemiBold" Foreground="#FFF2F5F8"/>
                      <TextBlock Text="Mémoire physique utilisée" FontSize="10" Foreground="#FF9CA8B4"/>
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>
                <TextBlock Text="COULEUR D'ACCENT" FontSize="10" FontWeight="Bold"
                           Foreground="#FFB8C3CE" Margin="0,9,0,10"/>
                <UniformGrid Columns="3">
                  <RadioButton x:Name="AccentIce" Tag="Ice" GroupName="Accent"
                               Style="{StaticResource AccentCard}">
                    <StackPanel HorizontalAlignment="Center">
                      <Ellipse Width="17" Height="17" Fill="#FFF1F6FC" HorizontalAlignment="Center"/>
                      <TextBlock Text="Glace" FontSize="10" Foreground="#FFE7EDF4"
                                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="AccentLilac" Tag="Lilac" GroupName="Accent"
                               Style="{StaticResource AccentCard}">
                    <StackPanel HorizontalAlignment="Center">
                      <Ellipse Width="17" Height="17" Fill="#FFD3A4FF" HorizontalAlignment="Center"/>
                      <TextBlock Text="Lilas" FontSize="10" Foreground="#FFE7EDF4"
                                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="AccentSteel" Tag="Steel" GroupName="Accent"
                               Style="{StaticResource AccentCard}">
                    <StackPanel HorizontalAlignment="Center">
                      <Ellipse Width="17" Height="17" Fill="#FF9DAFC4" HorizontalAlignment="Center"/>
                      <TextBlock Text="Acier" FontSize="10" Foreground="#FFE7EDF4"
                                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                  </RadioButton>
                </UniformGrid>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="CustomizeHint" Grid.Row="2" Text="Glissez une carte entre les zones ou utilisez son bouton. Glissez dans la liste pour changer l'ordre."
                       FontSize="10" Foreground="#FF8D98A4" VerticalAlignment="Bottom"/>
          </Grid>

          <Grid x:Name="LicensePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="LICENCE" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2"/>
              <TextBlock Text="À propos de Focus Control" FontSize="18" FontWeight="SemiBold"
                         Foreground="#FFF2F5F8" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="17" Background="#FF171B21" BorderBrush="#34FFFFFF"
                    BorderThickness="1" Padding="22" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Focus Control" FontSize="20" FontWeight="SemiBold" Foreground="#FFF2F5F8"/>
                <TextBlock Text="Créé par Vozura" FontSize="12" Foreground="#FFAFBAC5" Margin="0,6,0,18"/>
                <TextBlock Text="Licence du projet" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2"/>
                <TextBlock Text="Apache License, Version 2.0 — January 2004" FontSize="13"
                           Foreground="#FFE7DBF2" Margin="0,5,0,3"/>
                <TextBlock FontSize="11" Foreground="#FFAFBAC5" TextWrapping="Wrap">
                  <Run Text="https://www.apache.org/licenses/LICENSE-2.0"/>
                </TextBlock>
                <Border Height="1" Background="#25FFFFFF" Margin="0,18,0,13"/>
                <TextBlock Text="Composant tiers" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2"/>
                <TextBlock Text="PresentMon est distribué séparément sous licence MIT. Son avis de licence est fourni dans tools/PresentMon-LICENSE.txt."
                           FontSize="11" Foreground="#FFAFBAC5" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="RÉGLAGES" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2"/>
              <TextBlock Text="Une interface à votre rythme" FontSize="18" FontWeight="SemiBold"
                         Foreground="#FFF2F5F8" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border x:Name="DisplaySettingsSurface" CornerRadius="17" Background="#FF171B21" BorderBrush="#34FFFFFF"
                        BorderThickness="1" Padding="18">
                  <StackPanel>
                    <TextBlock Text="AFFICHAGE" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2" Margin="0,0,0,9"/>
                    <ToggleButton x:Name="SecondsToggle" Style="{StaticResource SwitchRow}" Content="Afficher les secondes"/>
                    <ToggleButton x:Name="TransparencyToggle" Style="{StaticResource SwitchRow}" Content="Fond translucide"/>
                    <TextBlock Text="Opacité de la fenêtre" FontSize="11" Foreground="#FFAFBAC5" Margin="0,10,0,4"/>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource FluidSlider}"
                            Minimum="0.62" Maximum="0.98" Value="0.86" IsEnabled="False"/>
                    <ToggleButton x:Name="MotionToggle" Style="{StaticResource SwitchRow}" Content="Réduire les animations" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border x:Name="OverlaySettingsSurface" Grid.Column="2" CornerRadius="17" Background="#FF171B21"
                      BorderBrush="#34FFFFFF" BorderThickness="1" Padding="18">
                <StackPanel>
                  <TextBlock Text="SUPERPOSITION" FontSize="10" FontWeight="Bold" Foreground="#FF9BA6B2" Margin="0,0,0,8"/>
                  <ToggleButton x:Name="PinToggle" Style="{StaticResource SwitchRow}" Content="Épingler à l'écran"/>
                  <TextBlock Text="Position à l'écran" FontSize="11" Foreground="#FFAFBAC5" Margin="0,11,0,7"/>
                  <UniformGrid Columns="2" Rows="2">
                    <RadioButton x:Name="PositionTopLeft" Tag="TopLeft" GroupName="Position"
                                 Style="{StaticResource PositionCard}" Content="Haut gauche"/>
                    <RadioButton x:Name="PositionTopRight" Tag="TopRight" GroupName="Position"
                                 Style="{StaticResource PositionCard}" Content="Haut droite"/>
                    <RadioButton x:Name="PositionBottomLeft" Tag="BottomLeft" GroupName="Position"
                                 Style="{StaticResource PositionCard}" Content="Bas gauche"/>
                    <RadioButton x:Name="PositionBottomRight" Tag="BottomRight" GroupName="Position"
                                 Style="{StaticResource PositionCard}" Content="Bas droite"/>
                  </UniformGrid>
                  <Border Height="1" Background="#25FFFFFF" Margin="2,14,2,7"/>
                  <ToggleButton x:Name="OverlayTranslucencyToggle" Style="{StaticResource SwitchRow}"
                                Content="Fond flottant translucide"/>
                  <TextBlock Text="Opacité du fond uniquement" FontSize="11" Foreground="#FFAFBAC5"
                             Margin="0,0,0,4"/>
                  <Slider x:Name="OverlayOpacitySlider" Style="{StaticResource FluidSlider}"
                          Minimum="0.12" Maximum="0.92" Value="0.46"/>
                  <TextBlock Text="La superposition laisse passer les clics et peut être composée dans Personnaliser."
                             FontSize="10" Foreground="#FF8E99A5" TextWrapping="Wrap" Margin="2,8,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
