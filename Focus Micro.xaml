<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test du micro" Width="520" Height="390"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI">
  <Border CornerRadius="22" Background="#FF101319" BorderBrush="#54FFFFFF"
          BorderThickness="1" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="44"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <StackPanel>
          <TextBlock Text="TEST DU MICRO" FontSize="10" FontWeight="Bold" Foreground="#FFB9A1CE"/>
          <TextBlock Text="Votre voix, en direct" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FFF4F6F9" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="MicroCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="32" Height="32" Background="Transparent" BorderBrush="Transparent"
                Foreground="#FFE8ECF2" FontSize="22" Content="×" Cursor="Hand"
                AutomationProperties.Name="Fermer le test micro"/>
      </Grid>
      <StackPanel Grid.Row="1">
        <TextBlock Text="CHOISIR UN MICROPHONE" FontSize="10" FontWeight="Bold"
                   Foreground="#FF9CA8B5" Margin="0,0,0,8"/>
        <ListBox x:Name="MicroDeviceList" Height="80" Background="#FF181D25"
                 BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Foreground="#FFF0F3F7" FontSize="12">
          <ListBox.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Padding" Value="9,6"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="DeviceFace" Background="Transparent" CornerRadius="8"
                            BorderBrush="Transparent" BorderThickness="1">
                      <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="DeviceFace" Property="Background" Value="#FF303040"/>
                        <Setter TargetName="DeviceFace" Property="BorderBrush" Value="#FFAA90C2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </StackPanel>
      <Border Grid.Row="3" CornerRadius="15" Background="#FF191E27"
              BorderBrush="#35FFFFFF" BorderThickness="1" Padding="15">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="23"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <TextBlock Text="NIVEAU D'ENTRÉE" FontSize="10" FontWeight="Bold" Foreground="#FF9EAAB7"/>
            <TextBlock x:Name="MicroPeakText" Text="0 %" FontSize="11" FontWeight="SemiBold"
                       Foreground="#FFE8EDF4" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel x:Name="MicroBarHost" Grid.Row="1" Orientation="Horizontal"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Height="75"/>
          <TextBlock x:Name="MicroStatusText" Grid.Row="2" Text="Aucun son n'est enregistré."
                     FontSize="10" Foreground="#FF97A4B1" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,11,0,0">
        <TextBlock Text="Le test s'arrête quand cette fenêtre se ferme." FontSize="10"
                   Foreground="#FF8995A3" VerticalAlignment="Center"/>
        <Button x:Name="MicroTestButton" Content="Démarrer le test" HorizontalAlignment="Right"
                Background="#FF3E344A" Foreground="#FFF4F0F8" BorderBrush="#65D2B5EA"
                BorderThickness="1" Padding="14,7" Cursor="Hand" FontWeight="SemiBold"/>
      </Grid>
    </Grid>
  </Border>
</Window>
